# 🎯 PORTFOLIO MODE (Recommended for CV/Interviews)
# Set to true to use demo AI (no API key needed) - ALWAYS WORKS
PORTFOLIO_MODE=true

# 🚀 LIVE MODE (Optional - for real AI)
# Set to false AND add API key to use OpenAI GPT
# PORTFOLIO_MODE=false
# OPENAI_API_KEY=sk-your-key-here

# 🔐 Authentication
JWT_SECRET=your_jwt_secret_here
MONGODB_URI=mongodb://localhost:27017/chat-app

# ⚙️ Server
PORT=5000